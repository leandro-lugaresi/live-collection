{
  "name": "@leandro-lugaresi/live-collection-server",
  "version": "4.1.0",
  "license": "MIT",
  "type": "module",
  "description": "Optional backend kernel for the live-collection sync system: event store port, in-process event bus, dispatcher (persist-then-publish), and the SyncFeed read path (catchup + SSE frames) that enforces the client contract's invariants. Transport-, storage-, and auth-agnostic.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leandro-lugaresi/live-collection.git",
    "directory": "packages/server"
  },
  "scripts": {
    "typecheck": "tsc -b && tsc -p tsconfig.test.json",
    "build": "tsc -b",
    "test": "vitest run --passWithNoTests"
  },
  "peerDependencies": {
    "@leandro-lugaresi/live-collection-protocol": "workspace:^",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@leandro-lugaresi/live-collection-protocol": "workspace:*",
    "effect": "catalog:"
  }
}
