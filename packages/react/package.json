{
  "name": "@leandro-lugaresi/live-collection-react",
  "version": "5.0.0",
  "license": "MIT",
  "type": "module",
  "description": "React bindings for @leandro-lugaresi/live-collection: useLiveCollection hook and runtime provider. Optional adapter so the core stays framework-neutral.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leandro-lugaresi/live-collection.git",
    "directory": "packages/react"
  },
  "scripts": {
    "typecheck": "tsc -b && tsc -p tsconfig.test.json",
    "build": "tsc -b",
    "test": "vitest run --passWithNoTests"
  },
  "peerDependencies": {
    "@leandro-lugaresi/live-collection": "workspace:^",
    "effect": "catalog:",
    "react": ">=18"
  },
  "devDependencies": {
    "@tanstack/react-db": "catalog:",
    "@leandro-lugaresi/live-collection": "workspace:*",
    "@leandro-lugaresi/live-collection-protocol": "workspace:*",
    "@types/react": "catalog:",
    "effect": "catalog:",
    "react": "catalog:"
  }
}
